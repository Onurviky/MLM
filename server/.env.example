DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-secret"
PORT=4000
CLIENT_URL="http://localhost:5173"

# Naranja X (credenciales que entrega Naranja X al adherir el comercio en https://www.naranjax.com/comercios)
NX_API_KEY=""
# Solo para desarrollo: reemplaza la pagina de pago de Naranja X por una simulada (aprobar / rechazar)
NX_SIMULATE=true

# SMTP para el email de codigo de seguimiento (Correo Argentino). Si se deja vacio, el envio se simula por consola.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu-email@gmail.com"
SMTP_PASS="app-password"
SMTP_FROM="MLM <no-reply@mlm.com>"
